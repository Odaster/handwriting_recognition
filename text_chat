# ИНСТРУКЦИЯ ПО ЗАПУСКУ (Ubuntu 24.04 на виртуальной машине)
# =====================================================================
#
# Ошибка выше: папка ~/ocr-pipeline/app НЕ является git-репозиторием (нет .git).
# Её создали вручную, а не через git clone, поэтому git pull применять не к чему.
# Решение — склонировать репозиторий заново.

# ---------------------------------------------------------------------
# ШАГ 1. Клонируем репозиторий (в домашней папке, НЕ внутри ocr-pipeline)
# ---------------------------------------------------------------------
cd ~
git clone https://github.com/Odaster/handwriting_recognition.git
cd handwriting_recognition
git checkout cursor/linux-install-debug-dd79

# Репозиторий приватный: при запросе логина/пароля вводите Personal Access Token
# (GitHub -> Settings -> Developer settings -> Personal access tokens) ВМЕСТО пароля.
# Либо клонируйте по SSH:
#   git clone git@github.com:Odaster/handwriting_recognition.git

# ---------------------------------------------------------------------
# ШАГ 2. Устанавливаем зависимости (один скрипт всё делает)
# ---------------------------------------------------------------------
bash scripts/install.sh

# Скрипт идемпотентный и ставит:
#   - apt: tesseract-ocr, tesseract-ocr-rus, python3-venv, python3-pip,
#          libgl1, libglib2.0-0
#     (python3-venv обязателен на чистой Ubuntu 24.04, иначе venv падает
#      с ошибкой "ensurepip is not available")
#   - venv .venv + лёгкие Python-пакеты (БЕЗ torch/CUDA)
# sudo попросит пароль — это нормально для установки системных пакетов.

# ---------------------------------------------------------------------
# ШАГ 3. Запускаем сервер
# ---------------------------------------------------------------------
.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000

# Затем открыть в браузере на VM:  http://localhost:8000

# ---------------------------------------------------------------------
# ШАГ 4. Быстрая проверка из терминала (в другом окне)
# ---------------------------------------------------------------------
.venv/bin/python scripts/make_sample.py --text "Привет, мир!" --out sample.png
curl -s -F "file=@sample.png" http://localhost:8000/api/recognize

